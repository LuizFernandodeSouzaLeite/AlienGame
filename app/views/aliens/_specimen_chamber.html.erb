<section class="containment-chamber" data-controller="specimen-chamber specimen-locomotion" data-state="<%= alien ? 'loading' : 'idle' %>" data-phase="<%= first_transfer ? 'transfer' : 'acquisition' %>" data-behavior="<%= profile&.primary_trait %>" data-archetype="<%= profile&.archetype %>" data-scale="<%= profile&.scale_class %>" data-materiality="<%= profile&.materiality %>" data-expressiveness="<%= profile&.expressiveness %>" data-first-transfer="<%= first_transfer %>" data-specimen-id="<%= alien&.id %>"
  data-specimen-locomotion-active-value="<%= alien.present? %>" data-specimen-locomotion-roams-value="<%= profile&.roams? %>" data-specimen-locomotion-locomotion-value="<%= profile&.locomotion %>" data-specimen-locomotion-scale-value="<%= profile&.scale_class %>"
  data-specimen-chamber-active-value="<%= alien.present? %>" data-specimen-chamber-first-transfer-value="<%= first_transfer %>"
  data-specimen-chamber-aggression-value="<%= profile&.behavior&.dig(:aggression) || 0 %>" data-specimen-chamber-curiosity-value="<%= profile&.behavior&.dig(:curiosity) || 0 %>"
  data-specimen-chamber-activity-value="<%= profile&.behavior&.dig(:activity) || 0 %>" data-specimen-chamber-fear-value="<%= profile&.behavior&.dig(:fear) || 0 %>"
  data-specimen-chamber-playfulness-value="<%= profile&.behavior&.dig(:playfulness) || 0 %>" data-specimen-chamber-reactivity-value="<%= profile&.behavior&.dig(:reactivity) || 0 %>"
  data-specimen-chamber-primary-value="<%= profile&.primary_label %>" data-specimen-chamber-secondary-value="<%= profile&.secondary_label %>"
  data-specimen-chamber-archetype-value="<%= profile&.archetype %>" data-specimen-chamber-impact-threshold-value="<%= profile&.impact_threshold || 12 %>">
  <div class="chamber-feed" aria-hidden="true"><span class="feed-fluid"></span><i>BF-02</i></div>
  <div class="chamber-crown" aria-hidden="true"><span class="crown-valve crown-valve--left"></span><span class="crown-valve crown-valve--right"></span><span class="crown-latch crown-latch--one"></span><span class="crown-latch crown-latch--two"></span><div class="crown-status"><i></i><i></i><i></i></div></div>
  <div class="scanner-rail scanner-rail--left" aria-hidden="true"><i></i></div><div class="scanner-rail scanner-rail--right" aria-hidden="true"><i></i></div>
  <div class="scanner-ring scanner-ring--upper" data-specimen-chamber-target="ring" aria-hidden="true"><i></i><i></i><b>SR-A</b></div><div class="scanner-ring scanner-ring--middle" data-specimen-chamber-target="ring" aria-hidden="true"><i></i><i></i><b>SR-B</b></div><div class="scanner-ring scanner-ring--lower" data-specimen-chamber-target="ring" aria-hidden="true"><i></i><i></i><b>SR-C</b></div>
  <div class="sensor-arm sensor-arm--left" data-specimen-chamber-target="sensorArm" aria-hidden="true"><span></span><i></i><b></b></div><div class="sensor-arm sensor-arm--right" data-specimen-chamber-target="sensorArm" aria-hidden="true"><span></span><i></i><b></b></div>
  <div class="tank-shell"><div class="tank-clamp tank-clamp--top" aria-hidden="true"></div><div class="tank-clamp tank-clamp--bottom" aria-hidden="true"></div>
    <div class="tank-glass" tabindex="<%= alien ? 0 : -1 %>" role="<%= alien ? 'button' : 'img' %>" aria-label="<%= alien ? "Observe and tap #{record_name(alien)} through the containment glass" : 'Empty specimen chamber' %>" data-action="pointermove->specimen-chamber#proximity pointerleave->specimen-chamber#leave click->specimen-chamber#tap keydown.enter->specimen-chamber#tap keydown.space->specimen-chamber#tap">
      <div class="fluid-meniscus" aria-hidden="true"></div><div class="bio-fluid" data-specimen-locomotion-target="bounds">
        <div class="fluid-caustics" aria-hidden="true"></div><div class="fluid-current" aria-hidden="true"></div><div class="tank-bubbles tank-bubbles--rear" aria-hidden="true"><% 9.times do |i| %><i style="--bubble: <%= i %>"></i><% end %></div><div class="suspended-particles" aria-hidden="true"><% 12.times do |i| %><i style="--particle: <%= i %>"></i><% end %></div>
        <div class="specimen" data-specimen-chamber-target="specimen" data-specimen-locomotion-target="specimen"><% if alien %><%= species_signature(alien) %><% else %><span class="empty-chamber-readout"><b>CHAMBER 01</b>NO SPECIMEN<br>READY</span><% end %></div>
        <div class="tank-bubbles tank-bubbles--front" aria-hidden="true"><% 7.times do |i| %><i style="--bubble: <%= i + 9 %>"></i><% end %></div><div class="fluid-wave" data-specimen-chamber-target="fluidWave" aria-hidden="true"></div>
      </div>
      <div class="glass-ripple" data-specimen-chamber-target="ripple" aria-hidden="true"></div><div class="glass-reflection" aria-hidden="true"></div><div class="scan-beam" data-specimen-chamber-target="scanner" aria-hidden="true"></div>
    </div>
  </div>
  <div class="chamber-base" aria-hidden="true"><div class="base-readout"><span>CH-01 // <b data-specimen-chamber-target="localState"><%= alien ? 'LINKING' : 'READY' %></b></span><strong><%= alien ? "A-#{file_number(alien)}" : "READY" %></strong></div><div class="base-connectors"><i></i><i></i><i></i></div><span class="base-seal"></span></div><div class="return-line" aria-hidden="true"><i>RETURN</i></div>
</section>
