<% content_for :title, "#{record_name(record)} · Spacerails" %>
<%= link_to polymorphic_path(record.class), class: "back-link" do %><%= space_icon("back") %> Back to <%= controller_name %><% end %>
<div class="file-heading"><p class="eyebrow"><%= space_section[:category] %> / <%= file_number(record) %></p><h1><%= space_section[:file] %> file<span>.</span></h1><p>A closer look at the extraordinary.</p></div>
<div class="detail-layout"><%= render record %><aside class="file-aside"><span class="eyebrow">Archive controls</span><h2>Every detail matters.</h2><p>Keep this entry up to date as your exploration continues.</p><%= link_to edit_polymorphic_path(record), class: "btn btn-primary" do %><%= space_icon("edit") %> Edit <%= space_section[:singular].downcase %><% end %><div class="danger-zone"><p>Delete this entry from the archive.</p><%= button_to record, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Delete #{record_name(record)}? #{record.is_a?(Planet) ? 'Aliens on this planet will also be deleted. ' : ''}This operation cannot be undone." } } do %><%= space_icon("trash") %> Delete file<% end %></div></aside></div>
